# SRC Node.js example. Never commit actual secrets.
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://src:src_dev_only@127.0.0.1:5433/src
CORS_ORIGIN=http://localhost:8000
SRC_JWT_SECRET=REPLACE_WITH_48_PLUS_CRYPTOGRAPHICALLY_RANDOM_BYTES
# Separate, stable 32-byte key encoded as 64 hex characters. Never store plaintext PAN.
SRC_PAN_ENCRYPTION_KEY=
SRC_PAYMENTS_ENABLED=false
# For non-fireworks goods only; set only after merchant approval and test configuration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Scheme Manager follow-ups: Resend HTTPS API works on Render Free (SMTP 25/465/587 is blocked).
# Verify your sender domain before enabling real customer email delivery.
RESEND_API_KEY=
RESEND_FROM=
# Password recovery still uses SMTP; see recovery.ts for current support.
# Account recovery requires a working outbound SMTP service or an approved email API.
APP_PUBLIC_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TRUST_PROXY=false

# Future scheme subscriptions: configuration only, NOT a payment activation switch.
# Credentials must be stored in server-only environment secrets, never in the web UI or Git.
# Razorpay subscriptions require independent merchant approval for the actual activity.
SRC_SCHEME_SUBSCRIPTIONS_ENABLED=false
# Sandbox only. Requires rzp_test_* key, secret, webhook secret and JWT secret; cannot use live keys.
SRC_SCHEME_PAYMENT_TEST_MODE_ENABLED=false
SRC_SCHEME_COMPLIANCE_REFERENCE=

# One-time bootstrap values are supplied interactively at runtime by scripts/bootstrap-superadmin.ps1
# SRC_BOOTSTRAP_EMAIL=
# SRC_BOOTSTRAP_PASSWORD=
# SRC_BOOTSTRAP_CONFIRM=
