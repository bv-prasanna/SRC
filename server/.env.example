# SRC Node.js example. Never commit actual secrets.
PORT=8080
NODE_ENV=development
DATABASE_URL=postgresql://src:src_dev_only@127.0.0.1:5433/src
CORS_ORIGIN=http://localhost:8000
SRC_ADMIN_TOKEN=replace-with-strong-random-development-only-token-32-chars
SRC_PAYMENTS_ENABLED=false
# For non-fireworks goods only; set only after merchant approval and test configuration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Account recovery requires a working outbound SMTP service or an approved email API.
APP_PUBLIC_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TRUST_PROXY=false

# Future scheme subscriptions: configuration only, NOT a payment activation switch.
# Credentials must be stored in server-only environment secrets, never in the web UI or Git.
# Razorpay subscriptions require independent merchant approval for the actual activity.
SRC_SCHEME_SUBSCRIPTIONS_ENABLED=false
SRC_SCHEME_COMPLIANCE_REFERENCE=
